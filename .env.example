# Local development only. Copy to .env.local only if that file does not exist.
# Select your own existing development deployment; do not copy another user's URLs.
CONVEX_DEPLOYMENT=dev:your-development-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud

# NEXT_PUBLIC_CONVEX_SITE_URL may be generated by Convex tooling, but is not read
# by this app or its installed Convex Auth Next.js integration. Not required.

# Configure these NAMES in the Convex deployment dashboard, NOT in this file.
# Backend secrets must never have a NEXT_PUBLIC_ prefix.
# OPENAI_API_KEY
# OPENAI_EXTRACTION_MODEL (optional; defaults to gpt-4.1-mini for both AI tasks)
# RESEND_API_KEY (sending plus receiving-read access)
# RESEND_WEBHOOK_SECRET (the selected webhook's signing secret)
# RESEND_FROM_EMAIL (verified sender for general recipients)
# RESEND_INBOUND_DOMAIN (bare receiving domain, not an email address)
# SITE_URL (recommended frontend origin; not required by password-only auth)
# JWT_PRIVATE_KEY
# JWKS

# CONVEX_SITE_URL and CONVEX_CLOUD_URL are provided by Convex automatically.
# Optional Vercel CI credential, only for automated backend deployment:
# CONVEX_DEPLOY_KEY
# Never put production keys in this example or copy development secrets to prod.
# See PRODUCTION_READINESS_REPORT.md for the staged deployment plan.
